<main-search>
  <div is="loading-indicator"></div>

  <form>
    <ul class="nav nav-tabs">
      <li class="nav-item {isFav() ? '' : 'active'}">
        <a
          class="nav-link"
          data-toggle="tab"
          data-target="#search-pane"
          href="#"
        >{cap(t('search'))}</a>
      </li>
      <li class="nav-item {!isFav() ? '' : 'active'}">
        <a
          class="nav-link"
          data-toggle="tab"
          data-target="#favorites-pane"
          href="#"
        >{cap(t('favorites'))} ({favCount()})</a>
      </li>
    </ul>

    <div class="tab-content">
      <div class="tab-pane fade {isFav() ? '' : 'active in'} pt-3" id="search-pane">
        <div
          is="fo-input"
          name="terms"
          label={cap(t('full_text_prompt'))}
          reset-page={true}
          on-input={props.onInput}
          value={props['criteria']['terms']}
        ></div>

        <div class="mb-2 mt-5">{cap(t('year_prompt'))}</div>

        <div
          is="year-selector"
          on-input={props.onInput}
          criteria={props['criteria']}
        }></div>

        <div class="mt-5">
          {cap(t('filter_results'))}
          <img is="help-icon" text={cap(t('filter_help'))} />
        </div>

        <div
          is="tree-view"
          on-input={props.onInput}
          criteria={props['criteria']}
        ></div>
      </div>
      
      <div class="tab-pane fade {!isFav() ? '' : 'active in'}" id="favorites-pane">
        <button class="btn btn-warning d-block mt-3 w-100">
          <img src="{config().root_url}/assets/images/csv.png" />
          {cap(t('export_csv'))}
        </button>
        <button class="btn btn-primary d-block mt-3 w-100">
          <img src="{config().root_url}/assets/images/check.png" />
          {cap(t('create_link'))}
        </button>
      </div>
    </div>

    <!-- button type="submit" class="btn btn-primary w-100 mt-3">{cap(t('verbs.search'))}</button -->
  </form>

  <script>
    import {Url} from '@wendig/lib'
    import watchlist from '../lib/watchlist'

    export default class {
      onMounted(props, state) {
        const toggles = this.root.querySelectorAll("[data-toggle='tab']")
        for (const t of toggles) {
          jQuery(t).on('show.bs.tab', event => {
            const target = t.getAttribute('data-target')
            const fav = (target === '#favorites-pane' ? 'true' : null)

            props.onInput({fav})
          })
        }
      }

      isFav() {
        return this.props['criteria']['fav'] === 'true'
      }

      favCount() {
        return watchlist.count()
      }
    }
  </script>
</main-search>
