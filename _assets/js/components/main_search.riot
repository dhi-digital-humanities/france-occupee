<main-search>
  <form>
    <ul class="nav nav-tabs">
      <li class="nav-item">
        <a
          class="nav-link {isFav() ? '' : 'active'}"
          data-bs-toggle="tab"
          data-bs-target="#search-pane"
          href="#"
        >{cap(t('search'))}</a>
      </li>
      <li class="nav-item">
        <a
          class="nav-link {!isFav() ? '' : 'active'}"
          data-bs-toggle="tab"
          data-bs-target="#favorites-pane"
          href="#"
        >{cap(t('favorites'))}</a>
      </li>
    </ul>

    <div class="tab-content">
      <div class="tab-pane fade {isFav() ? '' : 'show active'} pt-3" id="search-pane">
        <div
          is="fo-input"
          name="terms"
          label={cap(t('full_text_prompt'))}
          reset-page={true}
          on-input={props.onInput}
          value={props['criteria']['terms']}
        ></div>

        <div
          is="year-selector"
          on-input={props.onInput}
          criteria={props['criteria']}
        }></div>
      </div>
      
      <div class="tab-pane fade {!isFav() ? '' : 'show active'}" id="favorites-pane">
        <button class="btn btn-warning d-block mt-3 w-100">{cap(t('export_csv'))}</button>
        <button class="btn btn-primary d-block mt-3 w-100">{cap(t('create_link'))}</button>
      </div>
    </div>

    <!-- button type="submit" class="btn btn-primary w-100 mt-3">{cap(t('verbs.search'))}</button -->
  </form>

  <script>
    import {Tab} from 'bootstrap'
    import {Url} from '@wendig/lib'

    export default class {
      onMounted(props, state) {
        const toggles = this.root.querySelectorAll("[data-bs-toggle='tab']")
        for (const t of toggles) {
          const target = 
          t.addEventListener('show.bs.tab', event => {
            const target = t.getAttribute('data-bs-target')
            const fav = (target === '#favorites-pane' ? 'true' : null)

            props.onInput({fav})
          })
        }
      }

      isFav() {
        return this.props['criteria']['fav'] === 'true'
      }
    }
  </script>
</main-search>
