<place-popup>
  <div class="service-popup" class:has-image={props.imagePath} data-place-id={props.placeId}>
    <div if={props.placeName} class="popup-title">
      {props.placeName}
    </div>
    <div class="popup-tabs">
      <button class="tab-btn active" data-tab="info" onclick={switchTab}>
        INFORMATIONS
      </button>
      <button class="tab-btn" data-tab="services" onclick={switchTab}>
        SERVICES
      </button>
    </div>
    
    <div id="tab-info" class="tab-content active">
      <div class="address-section">
        <h4>Adresse</h4>
        <div if={props.address || props.city} class="address-row">
          {props.address || ''}{props.address && props.city ? ', ' : ''}{props.city || ''}
        </div>
        <div if={!props.address && !props.city} class="no-address">
          Aucune adresse disponible
        </div>
      </div>
      
      <div if={props.imagePath} class="image-container">
        <img src={this.imageUrl} alt={props.placeName || 'Place image'} onerror={handleImageError} />
      </div>
    </div>
    
    <div id="tab-services" class="tab-content">
      <div class="services-table-container">
        <table class="services-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Nom</th>
              <th>Organisation</th>
              <th class="text-center">Action</th>
            </tr>
          </thead>
          <tbody class="services-tbody">
            <tr>
              <td colspan="4" class="loading">Chargement...</td>
            </tr>
          </tbody>
        </table>
        <div class="services-pagination">
          <div class="pagination-controls">
            <button class="page-btn" data-action="first" onclick={handlePagination}>««</button>
            <button class="page-btn" data-action="prev" onclick={handlePagination}>«</button>
            <input type="number" class="page-input" value="1" min="1" onchange={handlePageInput} />
            <span class="page-info">sur 1</span>
            <button class="page-btn" data-action="next" onclick={handlePagination}>»</button>
            <button class="page-btn" data-action="last" onclick={handlePagination}>»»</button>
          </div>
          <div class="pagination-info"></div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import config from '../../../_data/config'
    import search from '../lib/search.instance'

    export default {
      onMounted(props, state) {
        state.currentPage = 1
        state.servicesLoaded = false
      },

      switchTab(event) {
        const tabName = event.target.getAttribute('data-tab')
        const tabButtons = this.root.querySelectorAll('.tab-btn')
        const tabContents = this.root.querySelectorAll('.tab-content')
        
        // Update active tab button
        tabButtons.forEach(btn => {
          btn.classList.remove('active')
        })
        event.target.classList.add('active')
        
        // Update active tab content
        tabContents.forEach(content => {
          content.classList.remove('active')
          content.style.display = 'none'
        })
        const activeContent = this.root.querySelector(`#tab-${tabName}`)
        if (activeContent) {
          activeContent.classList.add('active')
          activeContent.style.display = 'block'
          
          // Load services when switching to SERVICES tab
          if (tabName === 'services' && !this.state.servicesLoaded) {
            this.loadServices(this.props.placeId, 1)
            this.state.servicesLoaded = true
          }
        }
      },

      async loadServices(placeId, page) {
        const tbody = this.root.querySelector('.services-tbody')
        const pagination = this.root.querySelector('.services-pagination')
        
        try {
          const data = await search.servicesByPlace(placeId, page, 10)
          
          if (data.results.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" class="no-data">Aucun service trouvé</td></tr>'
          } else {
            tbody.innerHTML = data.results.map(service => {
              const date = service.date() || ''
              const name = service.name() || ''
              const hierarchy = service.hierarchy() || ''
              return `
                <tr>
                  <td>${date}</td>
                  <td>${name}</td>
                  <td>${hierarchy}</td>
                  <td class="text-center">
                    <button class="action-btn">+</button>
                  </td>
                </tr>
              `
            }).join('')
          }
          
          // Update pagination
          const pageInput = pagination.querySelector('.page-input')
          const pageInfo = pagination.querySelector('.page-info')
          const paginationInfo = pagination.querySelector('.pagination-info')
          
          pageInput.value = data.page
          pageInput.max = Math.ceil(data.total / data.perPage)
          pageInfo.textContent = `sur ${Math.ceil(data.total / data.perPage)}`
          paginationInfo.textContent = `Lignes de ${((data.page - 1) * data.perPage) + 1} à ${Math.min(data.page * data.perPage, data.total)} sur ${data.total}`
          
          // Update pagination buttons
          const firstBtn = pagination.querySelector('[data-action="first"]')
          const prevBtn = pagination.querySelector('[data-action="prev"]')
          const nextBtn = pagination.querySelector('[data-action="next"]')
          const lastBtn = pagination.querySelector('[data-action="last"]')
          
          firstBtn.disabled = data.page === 1
          prevBtn.disabled = data.page === 1
          nextBtn.disabled = data.page >= Math.ceil(data.total / data.perPage)
          lastBtn.disabled = data.page >= Math.ceil(data.total / data.perPage)
          
          this.state.currentPage = data.page
          
        } catch (error) {
          console.error('Error loading services:', error)
          tbody.innerHTML = '<tr><td colspan="4" class="error">Erreur lors du chargement</td></tr>'
        }
      },

      handlePagination(event) {
        const action = event.target.getAttribute('data-action')
        const pageInput = this.root.querySelector('.page-input')
        const placeId = parseInt(this.root.querySelector('.service-popup').getAttribute('data-place-id'))
        let page = parseInt(pageInput.value)
        
        switch(action) {
          case 'first':
            page = 1
            break
          case 'prev':
            page = Math.max(1, page - 1)
            break
          case 'next':
            page = Math.min(parseInt(pageInput.max), page + 1)
            break
          case 'last':
            page = parseInt(pageInput.max)
            break
        }
        
        this.loadServices(placeId, page)
      },

      handlePageInput(event) {
        const page = Math.max(1, Math.min(parseInt(event.target.max), parseInt(event.target.value) || 1))
        const placeId = parseInt(this.root.querySelector('.service-popup').getAttribute('data-place-id'))
        this.loadServices(placeId, page)
      },

      handleImageError(event) {
        event.target.style.display = 'none'
      },

      get imageUrl() {
        const imagePath = this.props.imagePath
        if (!imagePath) return ''
        
        const basePath = config().image_path || '/placeimages' // Mặc định là /placeimages
        const rootUrl = config().root_url || ''
        
        // Nếu basePath đã là URL (http:// hoặc https://), dùng trực tiếp
        if (basePath.startsWith('http://') || basePath.startsWith('https://')) {
          return `${basePath}/${imagePath}`
        }
        
        // Nếu basePath là đường dẫn tương đối (bắt đầu bằng /), dùng với root_url
        if (basePath.startsWith('/')) {
          return `${rootUrl}${basePath}/${imagePath}`
        }
        
        // Nếu là đường dẫn file system (E:\...), convert sang đường dẫn HTTP
        if (/^[A-Z]:/i.test(basePath)) {
          // Convert file system path sang HTTP path
          // E:\dhip-fo\placeimages -> /placeimages
          const urlPath = basePath.replace(/\\/g, '/')
          // Lấy tên thư mục cuối cùng (placeimages)
          const folderName = urlPath.split('/').pop()
          return `${rootUrl}/${folderName}/${imagePath}`
        }
        
        // Mặc định: dùng như đường dẫn tương đối
        return `${rootUrl}/${basePath}/${imagePath}`
      }
    }
  </script>
</place-popup>

