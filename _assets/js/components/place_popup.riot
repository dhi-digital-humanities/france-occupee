<place-popup>
  <div
    if={state.place && state.services}
    class="service-popup"
    class:has-image={!!state.imageUrl}
    data-place-id={state.placeId}
  >
    <div if={state.placeName} class="popup-title">
      {state.placeName}
    </div>
    <div class="popup-tabs">
      <button class="tab-btn active" data-tab="info" onclick={switchTab}>
        {cap(t('information'))}
      </button>
      <button class="tab-btn" data-tab="services" onclick={switchTab}>
        {cap(t('services'))}
      </button>
    </div>
    
    <div id="tab-info" class="tab-content active">
      <div class="address-section">
        <h4>{cap(t('address'))}</h4>
        <div if={state.place.hasAddress()} class="address-row">
          {state.address || ''}{state.address && state.city ? ', ' : ''}{state.city || ''}
        </div>
        <div if={!state.place.hasAddress()} class="no-address">
          {cap(t('no_address_available'))}
        </div>

        <template if={this.state.place.hasFormerAddress()}>
          <h4 class="mt-4">{cap(t('former_address'))}</h4>
          <div class="address-row">
            {state.place.formerAddress()}
          </div>
        </template>
      </div>
      
      <div if={state.imageUrl} class="image-container">
        <img src={state.imageUrl} alt={state.placeName || 'Place image'} onerror={handleImageError} />

        <div class="mt-3 text-center">{state.copyright}</div>
      </div>
    </div>
    
    <div id="tab-services" class="tab-content">
      <div class="services-table-container">
        <table class="services-table">
          <thead>
            <tr>
              <th>{cap(t('date'))}</th>
              <th>{cap(t('name'))}</th>
              <th>{cap(t('organization'))}</th>
              <th class="text-center">{cap(t('action'))}</th>
            </tr>
          </thead>
          <tbody class="services-tbody">
            <tr>
              <td colspan="4" class="loading"></td>
            </tr>
          </tbody>
        </table>

        <div if={state.services} is="pagination"
          total={state.services.length}
          per-page={10}
          page={state.page || 1}
          page-to={data => onPagination(data)}
        />
      </div>
    </div>
  </div>

  <script>
    import config from '../../../_data/config'
    import search from '../lib/search.instance'
    import {paginate} from '../lib/util'
    import {Url} from '@wendig/lib'

    export default class {
      onBeforeMount() {
        this.switchTab = this.switchTab.bind(this)

        this.on('load-popup-content', event => this.onLoadPopupContent(event))
      }

      switchTab(event) {
        const tabName = event.target.getAttribute('data-tab')
        const tabButtons = this.root.querySelectorAll('.tab-btn')
        const tabContents = this.root.querySelectorAll('.tab-content')
        
        // Update active tab button
        tabButtons.forEach(btn => {
          btn.classList.remove('active')
        })
        event.target.classList.add('active')
        
        // Update active tab content
        tabContents.forEach(content => {
          content.classList.remove('active')
          content.style.display = 'none'
        })
        const activeContent = this.root.querySelector(`#tab-${tabName}`)
        if (activeContent) {
          activeContent.classList.add('active')
          activeContent.style.display = 'block'
          
          // Load services when switching to SERVICES tab
          if (tabName === 'services' && !this.state.servicesLoaded) {
            this.loadServices(this.state.place.id(), 1)
            this.state.servicesLoaded = true
          }
        }
      }

      onPagination(data) {
        const page = data.page
        this.update({page})
      }

      onLoadPopupContent(event) {
        const placeId = event.data.placeId
        this.loadPlace(placeId)
      }

      async loadPlace(placeId) {
        let criteria = {
          id: placeId,
          status: 'visible',
          excludeDeleted: true
        }

        const url = Url.current()
        const p = url.hashParams()

        if (p['years']) criteria['years'] = p['years']

        search.place(criteria).then(data => {
          const place = data['place']
          const services = data['services']

          this.update({
            place: place,
            services: services,
            page: 1,
            address: place.address(),
            city: place.city(),
            placeName: place.name(),
            imageUrl: place.imageUrl(),
            copyright: place.copyright()
          })
        })
      }

      onUpdated() {
        this.loadServices()
      }

      loadServices() {
        if (!this.state.services) return

        const tbody = this.root.querySelector('.services-tbody')
        // const pagination = this.root.querySelector('.services-pagination')
        
        try {
          // const data = await search.servicesByPlace(placeId, page, 10)
          const services = paginate(this.state.services, 10, this.state.page || 1)
          
          if (services.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" class="no-data">Aucun service trouvé</td></tr>'
          } else {
            tbody.innerHTML = services.map(service => {
              const date = service.date() || ''
              const name = service.name() || ''
              const hierarchy = service.hierarchy() || ''
              return `
                <tr>
                  <td>${date}</td>
                  <td>${name}</td>
                  <td>${hierarchy}</td>
                  <td class="text-center">
                    <button class="action-btn">+</button>
                  </td>
                </tr>
              `
            }).join('')
          }
        } catch (error) {
          console.error('Error loading services:', error)
          tbody.innerHTML = '<tr><td colspan="4" class="error">Erreur lors du chargement</td></tr>'
        }
      }

      handleImageError(event) {
        event.target.style.display = 'none'
      }
    }
  </script>
</place-popup>
