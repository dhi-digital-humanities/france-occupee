<tree-view class="{props['margin'] && 'with-margin'}">
  <template if={isRoot()}>
    <div id="tree-popup" class="{state['modal'] ? 'modal fade' : ''}" tabindex="-1" role="dialog">
      <div class="tree-modal-content">
        <div
          is="tree-view"
          parent-id={-1}
          country="de"
          label={cap(t('services_allemands'))}
          on-input={props.onInput}
          criteria={props['criteria']}
          depth={depth() + 1}
        ></div>

        <div
          is="tree-view"
          parent-id={-1}
          country="fr"
          label={cap(t('services_francais'))}
          on-input={props.onInput}
          criteria={props['criteria']}
          depth={depth() + 1}
        ></div>
      </div>
    </div>
  </template>

  <template if={!isRoot()}>
    <div class="control">
      <a
        if={!state['data'] || state['data'].length > 0}
        href="#"
        onclick={event => onToggle(event)}
        class="toggle me-1"
      >
        <img if={!isExpanded()} class="tee-plus" src="{config().root_url}/assets/images/plus.gif" />
        <img if={isExpanded()} class="tee-plus" src="{config().root_url}/assets/images/minus.gif" />
      </a>

      <div if={state['data'] && state['data'].length === 0} class="input-spacer"></div>

      <input
        type="checkbox"
        onchange={event => onChange(event)}
        checked={state['checked']}
      />

      <div class="name">
        {props.label}
      </div>
    </div>

    <template if={state['data'] && !state['hidden']}>
      <ul class="list-unstyled">
        <li each={e in Object.entries(state['data'])}>
          <div
            is="tree-view"
            parent-id={e[1].ids}
            country={props['country']}
            label={e[1].label}
            on-input={props.onInput}
            criteria={props['criteria']}
            margin={true}
            depth={depth() + 1}
            is-first={e[0] === 0}
            is-last={e[0] === (state['data'].length - 1)}
            default-checked={state['checked']}
          ></div>
        </li>
      </ul>
    </template>
  </template>

  <script>
    import {util} from '@wendig/lib'
    import {encode} from '../lib/hierarchy'
    import search from '../lib/search.instance'

    const merge = (array) => {
      let r = {}
      for (const a of array) {
        Object.assign(r, a)
      }

      return r
    }

    export default class {
      onBeforeMount(props, state) {
        state['checked'] = this.checkedFromCriteria(props, props['defaultChecked'])

        if (this.isRoot()) {
          this.bus.on('tree-view:any-changed', event => this.onValueChanged())
        }
      }

      onMounted(props, state) {
        if (!this.isRoot()) return

        const element = document.querySelector('#tree-popup')

        this.bus.on('tree-popup', event => {
          this.update({modal: true})
          $(element).modal('show')
        })
        
        $(element).on('hidden.bs.modal', e => {
          this.update({modal: false})
          element.style.display = null;
        })
      }

      isRoot() {
        return !this.props['parentId'] && !this.props['country']
      }

      parentId() {
        return this.props['parentId'] || -1
      }

      isExpanded() {
        return this.state['data'] && !this.state['hidden']
      }

      depth() {
        return (
          this.props['depth'] !== undefined ?
          0 :
          this.props['depth']
        )
      }

      onToggle(event) {
        event.preventDefault()

        if (this.state['data']) {
          this.state['hidden'] = !this.state['hidden']
          this.update()
        } else {
          this.fetch()
        }
      }

      onChange(event) {
        const newState = this.input().checked

        this.setValue(newState)
        this.bus.emit('tree-view:any-changed', {value: this.value()})
        this.update()
      }

      input() {
        return this.root.querySelector(':scope > .control > input')
      }

      setValue(newValue) {
        this.state['checked'] = newValue

        for (const t of this.children()) {
          t.setValue(newValue)
        }
      }

      children() {
        const childComponents = this.tags || {}
        return childComponents['tree-view'] || []
      }

      onBeforeUpdate(props, state) {
        state['checked'] = this.checkedFromCriteria(props, props['defaultChecked'])

        if (!this.input()) return

        this.input().checked = state['checked']
      }

      ownKeys(props = this.props) {
        const parentId = props['parentId'] || -1

        if (parentId === -1) return props['country'] ? [props['country']] : []

        return (Array.isArray(parentId) ? parentId : [parentId]).map(id => `${id}`)
      }

      checkedFromCriteria(props, fallback) {
        const criteria = props['criteria'] || {}
        const hierarchy = criteria['hierarchy'] || {}

        for (const key of this.ownKeys(props)) {
          if (key in hierarchy) return !!hierarchy[key]
        }

        return !!fallback
      }

      toNode() {
        return {
          keys: this.ownKeys(),
          checked: this.state['checked'],
          children: this.children().map(child => child.toNode())
        }
      }

      checkedParam() {
        return encode(this.children().map(child => child.toNode()))
      }

      onValueChanged() {
        const value = this.value()
        const checked = this.checkedParam()

        this.bus.emit('tree-view:value-changed', {value, checked})
      }

      fetch() {
        console.log(this.parentId())

        const params = {
          parentId: this.parentId(),
          country: this.props['country'],
          perPage: 'max',
          status: ['visible', 'deleted']
        }

        search.services(params).then(data => {
          const groups = util.groupBy(data['results'], r => r.name())

          let combined = []
          for (const [k, gs] of Object.entries(groups)) {
            const ids = gs.map(g => g.id())
            combined.push({
              label: k,
              ids
            })
          }

          this.update({data: combined})
        })
      }

      value(results = {}) {
        const sv = this.state['checked']

        if (this.parentId() === -1) {
          if (this.props['country']) {
            results[this.props['country']] = sv
          }
        } else {
          for (const pi of this.parentId()) {
            results[pi] = sv
          }
        }

        for (const child of this.children()) {
          child.value(results)
        }

        return results
      }
    }
  </script>
</tree-view>