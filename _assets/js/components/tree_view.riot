<tree-view class="{props['margin'] && 'with-margin'}">
  <template if={isRoot()}>
    <div
      is="tree-view"
      parent-id={-1}
      country="de"
      label={cap(t('services_allemands'))}
      on-input={props.onInput}
      criteria={props['criteria']}
      actives={state['actives']}
      depth={depth() + 1}
    ></div>

    <div
      is="tree-view"
      parent-id={-1}
      country="fr"
      label={cap(t('services_francais'))}
      on-input={props.onInput}
      criteria={props['criteria']}
      actives={state['actives']}
      depth={depth() + 1}
    ></div>
  </template>

  <template if={!isRoot()}>
    <div class="control">
      <a
        if={!state['data'] || state['data']['results'].length > 0}
        href="#"
        onclick={event => onToggle(event)}
        class="toggle me-1"
      >
        <img if={!isExpanded()} class="tee-plus" src="{config.root_url}/assets/images/plus.gif" />
        <img if={isExpanded()} class="tee-plus" src="{config.root_url}/assets/images/minus.gif" />
      </a>

      <div if={state['data'] && state['data']['results'].length === 0} class="input-spacer"></div>

      <input
        type="checkbox"
        onchange={event => onChange(event)}
        checked={state['checked']}
      />

      <div class="name">
        {props.label}
      </div>
    </div>

    <template if={state['data'] && !state['hidden']}>
      <ul class="list-unstyled">
        <li each={e in Object.entries(state['data']['results'])}>
          <div
            is="tree-view"
            parent-id={e[1].id()}
            country={props['country']}
            label={e[1].name()}
            on-input={props.onInput}
            criteria={props['criteria']}
            margin={true}
            depth={depth() + 1}
            is-first={e[0] === 0}
            is-last={e[0] === (state['data']['results'].length - 1)}
            default-checked={state['checked']}
          ></div>
        </li>
      </ul>
    </template>
  </template>

  <script>
    import {util} from '@wendig/lib'
    import search from '../lib/search.instance'
    import config from '../../../_data/config'

    export default class {
      constructor() {
        this.config = config
      }

      onBeforeMount(props, state) {
        state['checked'] = props['defaultChecked'] || false
        state['actives'] = props['actives'] || {}

        this.bus.on('tree-view:any-changed', event => this.onAnyChanged())
      }

      isRoot() {
        return !this.props['parentId'] && !this.props['country']
      }

      parentId() {
        return this.props['parentId'] || -1
      }

      isExpanded() {
        return this.state['data'] && !this.state['hidden']
      }

      depth() {
        return (
          this.props['depth'] !== undefined ?
          0 :
          this.props['depth']
        )
      }

      onToggle(event) {
        event.preventDefault()

        if (this.state['data']) {
          this.state['hidden'] = !this.state['hidden']
          this.update()
        } else {
          this.fetch()
        }

        console.log('parent', this.parent)
      }

      onChange(event) {
        const newState = this.input().checked

        this.setValue(newState)
        this.bus.emit('tree-view:any-changed')
        this.update()
      }

      input() {
        return this.root.querySelector(':scope > .control > input')
      }

      value() {
        
      }

      setValue(newValue) {
        this.state['checked'] = newValue

        for (const t of this.children()) {
          t.setValue(newValue)
        }
      }

      children() {
        const childComponents = this.tags || {}
        return childComponents['tree-view'] || []
      }

      onBeforeUpdate() {
        if (!this.input()) return

        this.input().checked = this.state['checked']
      }

      onAnyChanged() {
        if (!this.input()) return

        this.input().indeterminate = this.isIndeterminate()
      }

      isIndeterminate() {
        if (!this.state['data']) return false
        if (this.children().length === 0) return false

        let tracker = null
        for (const c of this.children()) {
          if (c.isIndeterminate()) return true

          if (tracker === null) {
            tracker = c.state['checked']
            continue
          }

          if (tracker !== c.state['checked']) return true
        }

        return false
      }

      fetch() {
        const params = {
          parentId: this.parentId(),
          country: this.props['country'],
          perPage: 'max'
        }

        search.services(params).then(data => {
          // console.log(data)

          this.update({data})
        })
      }
    }
  </script>
</tree-view>