<fo-input class={props.class}>
  <label
    for={props.id || props.name}
    class="form-label"
  >{props.label}</label>
  <input
    id={props.id || props.name}
    name={props.name}
    value={propsValue()}
    checked={propsChecked()}
    type={props.type || 'text'}
    class="form-control"
    id="full_text"
    onkeyup={event => onChange(event)}
    autocomplete="off"
    spellcheck="false"
    placeholder={props.placeholder}
    oninput={event => onChange(event)}
    onfocus={event => onFocus(event)}
    onblur={evebt => onBlur(event)}
  />

  <script>
    import {util} from '@wendig/lib'

    export default class {
      onBeforeMount(props) {
        this.onInputDelayed = util.delay(props.onInput, 300)
      }

      onChange(event) {
        let values = {[this.props.name]: this.getValue()}
        if (this.props.resetPage) {
          values['page'] = null
        }

        this.onInputDelayed(values)
      }

      onKeyup(event) {
        const h = this.props.onkeyup
        if (h) h(event)
      }

      onFocus(event) {
        const h = this.props.onfocus
        if (h) h(event)

        if (this.getValue()) return
          
        this.update({help: true})
      }

      onBlur(event) {
        const h = this.props.onblur
        if (h) h(event)

        this.update({help: false})
      }

      onHelpClick(event) {
        event.preventDefault()

        this.update({help: !this.state.help})
      }

      propsValue() {
        if (this.props.type == 'checkbox') {
          return 'cb-value'
        }

        return this.props.value
      }

      propsChecked() {
        if (this.props.type == 'checkbox') {
          return this.props.value
        }

        return false
      }

      getValue() {
        if (this.props.type == 'checkbox') {
          const checked = this.root.querySelector('input').checked
          return checked || null
        }

        return this.root.querySelector('input').value
      }
    }
  </script>
</fo-input>