<fav-control>
  <a onclick={event => toggle(event)} href="#">
    <img if={isActive()} src="{config().root_url}/assets/images/trash_light.png" />
    <img if={!isActive()} src="{config().root_url}/assets/images/plus.png" />
  </a>

  <script>
    import watchlist from '../lib/watchlist'
    import config from '../../../_data/config'

    export default class {
      constructor() {
        this.config = config
      }

      isActive() {
        return watchlist.has(this.props['serviceId'])
      }

      toggle() {
        event.preventDefault()

        watchlist.toggle(this.props['serviceId'])
        this.update()

        this.bus.emit('favs:changed')
      }
    }
  </script>
</fav-control>
