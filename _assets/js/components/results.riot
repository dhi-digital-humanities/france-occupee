<results>
  <div class="d-flex justify-content-end">
    <ul class="nav nav-tabs">
      <li class="nav-item">
        <a
          class="nav-link"
          data-toggle="tab"
          data-target="#map-pane"
          href="#"
        >{cap(t('map_view'))}</a>
      </li>
      <li class="nav-item active">
        <a
          class="nav-link"
          data-toggle="tab"
          data-target="#list-pane"
          href="#"
        >{cap(t('list_view'))}</a>
      </li>
    </ul>
  </div>

  <div class="tab-content">
    <div class="tab-pane fade" id="map-pane">
      <div
        is="world-map"
        map-data={props['mapData']}
      ></div>
    </div>
    <div class="tab-pane fade active in position-relative" id="list-pane">
      <div
        is="sub-form"
        on-input={props['onInput']}
        criteria={props['criteria']}
      ></div>

      <template if={props['data']}>
        <table class="table">
          <thead>
            <tr>
              <th scope="col">{cap(t('city'))}</th>
              <th scope="col">{cap(t('date'))}</th>
              <th scope="col">{cap(t('name'))}</th>
              <th scope="col">{cap(t('address'))}</th>
              <th scope="col" class="text-column">{cap(t('organization'))}</th>
              <th scope="col" class="text-end">{cap(t('action'))}</th>
            </tr>
          </thead>
          <tbody>
            <tr each={service in props['data']['results']}>
              <td>{service.city()}</td>
              <td>{service.date()}</td>
              <td>{service.name()}</td>
              <td>{service.address()}</td>
              <td>{service.hierarchy()}</td>
              <td class="text-end">
                <div is="fav-control" service-id={service.id()}></div>
              </td>
            </tr>
          </tbody>
        </table>

        <div class="container-fluid position-fixed bottom-0 start-0 end-0 bg-white">
          <div class="row">
            <div class="col-xs-9 col-xs-offset-3 p-4">
              <div
                is="pagination"
                page={props['data']['page']}
                per-page={props['data']['perPage']}
                total={props['data']['total']}
                page-to={props.onInput}
              ></div>
            </div>
          </div>
        </div>
      </template>
    </div>
  </div>

  <script>
    export default class {
      onUpdated(props) {
        // console.log(props['data']['results'])
      }
    }
  </script>
</results>
