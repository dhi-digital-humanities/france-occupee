<results>
  <div class="tabs d-flex justify-content-end">
    <ul class="nav nav-tabs">
      <li class="nav-item {state['results'] == 'map' ? 'active' : ''}">
        <a
          class="nav-link"
          data-toggle="tab"
          data-target="#map-pane"
          href="#"
        >
          <img src="{config().root_url}/assets/images/map_primary.png" class="active" />
          <img src="{config().root_url}/assets/images/map.png" class="inactive" />
          {cap(t('map_view'))}
        </a>
      </li>
      <li class="nav-item {state['results'] != 'map' ? 'active' : ''}">
        <a
          class="nav-link"
          data-toggle="tab"
          data-target="#list-pane"
          href="#"
        >
          <img src="{config().root_url}/assets/images/list_primary.png" class="active" />
          <img src="{config().root_url}/assets/images/list.png" class="inactive" />
          {cap(t('list_view'))}
        </a>
      </li>
    </ul>
  </div>

  <div class="tab-content">
    <div class="tab-pane fade in {state['results'] == 'map' ? 'active' : ''}" id="map-pane">
      <div
        is="world-map"
        map-data={props['mapData']}
        is-active={state['results'] == 'map'}
        criteria={props['criteria']}
      ></div>
    </div>
    <div class="tab-pane fade in {state['results'] != 'map' ? 'active' : ''} position-relative" id="list-pane">
      <div
        is="sub-form"
        on-input={props['onInput']}
        criteria={props['criteria']}
      ></div>

      <template if={props['data']}>
        <div
          is="pagination"
          page={props['data']['page']}
          per-page={props['data']['perPage']}
          total={props['data']['total']}
          page-to={props.onInput}
        ></div>

        <table class="table table-striped table-condensed">
          <thead is="order-control" fields={fields()} criteria={props.criteria} />
          <tbody>
            <tr each={service in props['data']['results']}>
              <td title={service.id()}>{service.city()}</td>
              <td>{service.date()}</td>
              <td>{service.name()}</td>
              <td>
                <a href="#" onclick={event => onOpenPopup(service, event)}>
                  {service.address()}
                </a>
              </td>
              <td>{service.hierarchy()}</td>
              <td class="text-end">
                <div is="fav-control" service-id={service.id()}></div>
              </td>
            </tr>
          </tbody>
        </table>

        <div
          is="pagination"
          page={props['data']['page']}
          per-page={props['data']['perPage']}
          total={props['data']['total']}
          page-to={props.onInput}
        ></div>
      </template>
    </div>
  </div>

  <script>
    export default class {
      onBeforeMount(props, state) {
        state['results'] = props['criteria']['results']
      }

      onMounted(props, state) {
        const toggles = this.root.querySelectorAll("[data-toggle='tab']")
        for (const t of toggles) {
          jQuery(t).on('shown.bs.tab', event => {
            // the map component needs some time to settle before it can work,
            // to avoid errors, we wait for 100ms
            window.setTimeout(() => {
              const target = t.getAttribute('data-target')
              const results = (target === '#map-pane' ? 'map' : null)
              
              props.onInput({results})
            }, 100)
          })
        }
      }

      onOpenPopup(service, event) {
        event.preventDefault()

        this.emit('open-modal', {
          style: 'component',
          component: 'place-popup'
        })
        this.emit('load-popup-content', {placeId: service.placeId()})
      }

      fields() {
        return {
          fields: [
            {name: 'city', label: this.cap(this.t('city'))},
            {name: 'date', label: this.cap(this.t('date'))},
            {name: 'name', label: this.cap(this.t('name'))},
            {name: 'address', label: this.cap(this.t('address'))},
            {name: 'organization', label: this.cap(this.t('organization'))},
            {label: this.cap(this.t('action'))}
          ],
          default: 'name'
        }
      }
    }
  </script>
</results>
