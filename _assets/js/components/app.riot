<app app-id="fo">
  <div class="container-fluid p-4">
    <div class="row">
      <div class="col-xs-2">
        <div
          is="main-search"
          on-input={onInput}
          criteria={state['criteria']}
        ></div>
      </div>
      <div class="col-xs-10">
        <div
          is="results"
          data={state['data']}
          map-data={state['mapData']}
          on-input={onInput}
          criteria={state['criteria']}
        ></div>
      </div>
    </div>
  </div>

  <div is="modal"></div>

  <script>
    import {UrlSearch, Url} from '@wendig/lib'
    import search from '../lib/search.instance'
    import watchlist from '../lib/watchlist'

    let params = null

    export default class {
      constructor() {
        params = (cmp) => {
          const url = Url.current()
          let p = url.hashParams()
          p['page'] = parseInt(p['page'] || 1)
          p['perPage'] = parseInt(p['perPage'] || 10)
          p['hierarchy'] = this.state['hierarchy']

          return p
        }

        this.onSearch = this.onSearch.bind(this)
        this.urlSearch = new UrlSearch(this, {
          getParams: params
        })
      }

      onBeforeMount(props, state) {
        this.urlSearch.setup()

        this.bus.on('tree-view:value-changed', (event) => {
          const hierarchy = event.data.value
          this.state['hierarchy'] = hierarchy

          const url = Url.current()
          url.updateHashParams({page: null})
          url.apply(false)

          this.onUrlChanged()
        })

        this.bus.on('favs:changed', event => {
          const p = params()
          if (p['fav']) this.onUrlChanged()
        })
      }

      onSearch(p) {
        let promises = []

        if (p['fav'] == 'true') {
          const ids = watchlist.unpack()
          p['id'] = ids.map(id => `${id}`).join(',')
        }
        p['perPage'] = 15
        p['status'] = 'visible'
        // console.log(p)

        promises.push(search.services(p))

        p = structuredClone(p)
        delete p['page']
        p['perPage'] = 'max'
        p['onlyGeo'] = true
        promises.push(search.servicesMap(p))

        Promise.all(promises).then(datas => {
          const [data, mapData] = datas
          
          this.update({data, mapData})
          this.bus.emit('new-results')
        })
      }
    }
  </script>
</app>
