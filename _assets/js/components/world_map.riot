<world-map>
  <div class="map"></div>

  <div class="d-none">
    <div is="place-popup"></div>
  </div>

  <a
    href="#"
    onclick={event => onFullScreen(event)}
    class="full-screen-button"
  ><img src="{config().root_url}/assets/images/maximize.svg"></a>

  <script>
    import * as L from 'leaflet'
    import * as protomapsL from 'protomaps-leaflet'
    import 'leaflet.markercluster'
    import riot from '../lib/riot'
    import cache from '../lib/cache.instance'
    import config from '../../../_data/config'

    export default class {
      onMounted(props, state) {
        this.buildMap()

        const observer = new ResizeObserver((entries, observer) => {
          state['map'].invalidateSize()
        })
        observer.observe(this.root)
      }

      buildMap() {
        // Thuy, you can initialize the map but there is no data yet

        const element = this.root.querySelector('.map')
        const map = L.map(element, {
          zoomControl: true,
          minZoom: 3,
          maxZoom: 18
        })

        map.setView([51.505, -0.09], 6);

        const layer = protomapsL.leafletLayer({
          flavor: "light",
          lang: "en",
          url: config().pmtiles_url
        })
        layer.addTo(map)

        const markers = L.markerClusterGroup({
          iconCreateFunction: (cluster) => {
            return this.createClusterIcon(cluster)
          },
          maxClusterRadius: 50
        })
        markers.addTo(map)

        // register popup function
        const popupContent = this.root.querySelector("[is='place-popup']")
        markers.on('click', event => {
          const marker = event.layer
          const service = marker.service

          const map = this.state['map']
          map.openPopup(popupContent, marker.getLatLng(), {
            maxWidth: 600,
            maxHeight: 800,
            className: 'service-popup-container',
            offset: [0, -10]
          })

          this.emit('load-popup-content', {
            placeId: service.placeId()
          })
        })

        this.state['map'] = map
        this.state['markers'] = markers
      }

      onFullScreen(event) {
        event.preventDefault()

        if (this.state['fullScreen']) {
          document.exitFullscreen().then(() => {
            this.update({fullScreen: false})
          })
        } else {
          this.root.requestFullscreen().then(() => {
            this.update({fullScreen: true})
          })
        }
      }

      getIconForCountry(country) {
        const rootUrl = this.config().root_url || ''
        let iconUrl = `${rootUrl}/assets/images/marker-icon.png`
        
        if (country === 'fr') {
          iconUrl = `${rootUrl}/assets/images/f-fr.png`
        } else if (country === 'de') {
          iconUrl = `${rootUrl}/assets/images/de.png`
        }

        return L.icon({
          iconUrl: iconUrl,
          iconSize: [25, 25],
          iconAnchor: [12, 12],
          popupAnchor: [0, -12]
        })
      }

      createClusterIcon(cluster) {
        const rootUrl = this.config().root_url || ''
        const markers = cluster.getAllChildMarkers()
        
        // Đếm số lượng theo từng loại country
        let frCount = 0
        let deCount = 0
        let otherCount = 0

        markers.forEach(marker => {
          const country = marker.options.country
          if (country === 'fr') {
            frCount++
          } else if (country === 'de') {
            deCount++
          } else {
            otherCount++
          }
        })

        // Xác định icon và số lượng hiển thị
        let iconUrl
        let count
        let hasBoth = frCount > 0 && deCount > 0

        if (hasBoth) {
          // Nếu có cả fr và de, dùng f-fr-de.png và tổng số lượng
          iconUrl = `${rootUrl}/assets/images/f-fr-de.png`
          count = frCount + deCount + otherCount
        } else if (frCount > 0) {
          // Chỉ có fr
          iconUrl = `${rootUrl}/assets/images/f-fr.png`
          count = frCount + otherCount
        } else if (deCount > 0) {
          // Chỉ có de
          iconUrl = `${rootUrl}/assets/images/de.png`
          count = deCount + otherCount
        } else {
          // Không có fr hoặc de
          iconUrl = `${rootUrl}/assets/images/marker-icon.png`
          count = otherCount
        }

        // Tạo div chứa icon và số lượng
        const html = `
          <div class="fo-cluster-icon">
            <div>
              <img src="${iconUrl}" />
              <div>${count}</div>
            </div>
          </div>
        `
        
        return L.divIcon({
          html: html,
          className: 'fo-cluster-div-icon',
          iconSize: L.point(40, 40)
        })
      }

      onUpdated(props, state) {
        this.refresh()
      }

      refresh() {
        if (!this.root.checkVisibility()) return

        const data = this.props['mapData']
        const markers = this.state['markers']

        markers.clearLayers()

        let bulk = []
        for (const service of data['results']) {
          const country = service.country()
          const icon = this.getIconForCountry(country)
          const marker = L.marker(service.geo(), { 
            icon: icon,
            country: country // Lưu country vào marker để dùng khi clustering
          })
          
          // Lưu service vào marker để dùng khi click
          marker.service = service

          bulk.push(marker)
        }

        markers.addLayers(bulk, {chunkedLoading: true})

        let bounds = markers.getBounds()
        if (!bounds['_northEast']) {
          bounds = [
            [40.04443758460859, -20.608574060749856],
            [56.559482483762245, 32.345527501750155]
          ]
        }

        this.state['map'].flyToBounds(bounds, {duration: 1.0, easeLinearity: 1.0})
      }
    }
  </script>
</world-map>