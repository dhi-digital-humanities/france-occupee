<world-map>
  <div class="map"></div>

  <script>
    import * as L from 'leaflet'
    import * as protomapsL from 'protomaps-leaflet'

    export default class {
      onMounted(props, state) {
        this.buildMap()

        const observer = new ResizeObserver((entries, observer) => {
          state['map'].invalidateSize()
        })
        observer.observe(this.root)
      }

      buildMap() {
        // Thuy, you can initialize the map but there is no data yet

        const element = this.root.querySelector('.map')
        const map = L.map(element).
          setView([51.505, -0.09], 6).
          setMaxZoom(6);
        // const url = 'https://build.protomaps.com/20251103.pmtiles'
        // const url = '/assets/overview.pmtiles'
        const url = 'https://static.wendig.io/private/Ahpul5ph/overview.pmtiles'

        const layer = protomapsL.leafletLayer({
          flavor: "light",
          lang: "en",
          url
        })
        layer.addTo(map)

        const markers = L.layerGroup()
        markers.addTo(map)

        this.state['map'] = map
        this.state['markers'] = markers
      }

      onUpdated(props, state) {
        const data = props['mapData']
        // console.log(data)
        // Thuy: here, `props['mapData]` has the data
        // console.log(props['mapsData'])
        // for example:

        const markers = state['markers']

        markers.clearLayers()
        for (const service of data['results']) {
          const marker = L.marker(service.geo())
          markers.addLayer(marker)
        }
      }
    }
  </script>
</world-map>