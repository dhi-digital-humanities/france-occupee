<world-map>
  <div class="map"></div>

  <a
    href="#"
    onclick={event => onFullScreen(event)}
    class="full-screen-button"
  ><img src="{config().root_url}/assets/images/maximize.svg"></a>

  <script>
    import * as L from 'leaflet'
    import * as protomapsL from 'protomaps-leaflet'
    import 'leaflet.markercluster'
    import * as riot from 'riot'
    import cache from '../lib/cache.instance'
    import config from '../../../_data/config'

    export default class {
      onMounted(props, state) {
        this.buildMap()

        const observer = new ResizeObserver((entries, observer) => {
          state['map'].invalidateSize()
        })
        observer.observe(this.root)
      }

      buildMap() {
        // Thuy, you can initialize the map but there is no data yet

        const element = this.root.querySelector('.map')
        const map = L.map(element, {
          zoomControl: true,
          minZoom: 3,
          maxZoom: 18
        }).
          setView([51.505, -0.09], 6);
        // xyz layer
        // const layer = L.tileLayer(
        //   'https://tile.openstreetmap.de/{z}/{x}/{y}.png',
        //   {
        //     maxZoom: 18
        //   }
        // )

        // protomaps layer
        const url = 'https://build.protomaps.com/20260225.pmtiles'
        // const url = `${config().root_url}/map.pmtiles`
        const layer = protomapsL.leafletLayer({
          flavor: "light",
          lang: "en",
          url: url
        })

        layer.addTo(map)

        const markers = L.markerClusterGroup({
          iconCreateFunction: (cluster) => {
            return this.createClusterIcon(cluster)
          },
          maxClusterRadius: 50
        })
        markers.addTo(map)

        map.on('popupopen', event => this.onPopup(event))

        this.state['map'] = map
        this.state['markers'] = markers
      }

      onFullScreen(event) {
        event.preventDefault()

        if (this.state['fullScreen']) {
          document.exitFullscreen().then(() => {
            this.update({fullScreen: false})
          })
        } else {
          this.root.requestFullscreen().then(() => {
            this.update({fullScreen: true})
          })
        }
      }

      getIconForCountry(country) {
        const rootUrl = this.config().root_url || ''
        let iconUrl = `${rootUrl}/assets/images/marker-icon.png`
        
        if (country === 'fr') {
          iconUrl = `${rootUrl}/assets/images/f-fr.png`
        } else if (country === 'de') {
          iconUrl = `${rootUrl}/assets/images/de.png`
        }

        return L.icon({
          iconUrl: iconUrl,
          iconSize: [25, 25],
          iconAnchor: [12, 12],
          popupAnchor: [0, -12]
        })
      }

      createClusterIcon(cluster) {
        const rootUrl = this.config().root_url || ''
        const markers = cluster.getAllChildMarkers()
        
        // Đếm số lượng theo từng loại country
        let frCount = 0
        let deCount = 0
        let otherCount = 0

        markers.forEach(marker => {
          const country = marker.options.country
          if (country === 'fr') {
            frCount++
          } else if (country === 'de') {
            deCount++
          } else {
            otherCount++
          }
        })

        // Xác định icon và số lượng hiển thị
        let iconUrl
        let count
        let hasBoth = frCount > 0 && deCount > 0

        if (hasBoth) {
          // Nếu có cả fr và de, dùng f-fr-de.png và tổng số lượng
          iconUrl = `${rootUrl}/assets/images/f-fr-de.png`
          count = frCount + deCount + otherCount
        } else if (frCount > 0) {
          // Chỉ có fr
          iconUrl = `${rootUrl}/assets/images/f-fr.png`
          count = frCount + otherCount
        } else if (deCount > 0) {
          // Chỉ có de
          iconUrl = `${rootUrl}/assets/images/de.png`
          count = deCount + otherCount
        } else {
          // Không có fr hoặc de
          iconUrl = `${rootUrl}/assets/images/marker-icon.png`
          count = otherCount
        }

        // Tạo div chứa icon và số lượng
        const html = `
          <div class="fo-cluster-icon">
            <div>
              <img src="${iconUrl}" />
              <div>${count}</div>
            </div>
          </div>
        `
        
        return L.divIcon({
          html: html,
          className: 'fo-cluster-div-icon',
          iconSize: L.point(40, 40)
        })
      }

      createPopupContent(service) {
        // Tạo placeholder div, sẽ được thay thế khi popup mở
        const container = document.createElement('div')
        container.style.minWidth = '600px'
        container.style.maxWidth = '800px'
        container.innerHTML = '<div style="padding: 20px; text-align: center;">Chargement...</div>'
        
        // Lưu service để mount component sau
        container._service = service
        
        return container
      }

      onUpdated(props, state) {
        this.refresh()
      }

      refresh() {
        if (!this.root.checkVisibility()) return

        const data = this.props['mapData']
        console.log(data)
        // Thuy: here, `props['mapData]` has the data
        // console.log(props['mapsData'])
        // for example:

        const markers = this.state['markers']

        markers.clearLayers()

        let bulk = []
        for (const service of data['results']) {
          const country = service.country()
          const icon = this.getIconForCountry(country)
          const marker = L.marker(service.geo(), { 
            icon: icon,
            country: country  // Lưu country vào marker để dùng khi clustering
          })
          
          // Lưu service vào marker để dùng khi click
          marker.service = service
          
          // Tạo popup với thông tin service
          const popupContent = this.createPopupContent(service)
          marker.bindPopup(popupContent, {
            maxWidth: 800,
            minWidth: 600,
            className: 'service-popup-container'
          })

          bulk.push(marker)
        }

        markers.addLayers(bulk, {chunkedLoading: true})

        let bounds = markers.getBounds()
        if (!bounds['_northEast']) {
          bounds = [
            [40.04443758460859, -20.608574060749856],
            [56.559482483762245, 32.345527501750155]
          ]
        }

        this.state['map'].flyToBounds(bounds, {duration: 1.0, easeLinearity: 1.0})
      }

      onPopup(event) {
        const marker = event.popup._source
        const popup = event.popup

        if (!popup) return
            
        const element = popup.getElement()
        if (element) {
          const container = element.querySelector('div[style*="min-width: 600px"]')
          if (container && container._service && !container._popupMounted) {
            // Đợi một chút để đảm bảo DOM đã sẵn sàng
            setTimeout(() => {
              try {
                const service = container._service
                const address = service.address()
                const city = service.city()
                const placeId = service.placeId()
                const placeName = service.placeName()
                const imageUrl = service.imageUrl()
                
                // Tạo element với attribute is để mount component
                container.innerHTML = `<div is="place-popup"></div>`
                const popupElement = container.querySelector('[is="place-popup"]')
                
                if (popupElement) {
                  const mounted = riot.mount(popupElement, {
                    placeId: placeId,
                    placeName: placeName,
                    address: address,
                    city: city,
                    imageUrl: imageUrl
                  })
                  
                  // Popup luôn có chiều cao cố định 350px
                  if (mounted && mounted.length > 0) {
                    const popupWrapper = element.closest('.leaflet-popup-content-wrapper')
                    const popupContent = element.closest('.leaflet-popup-content')
                    if (popupWrapper) {
                      popupWrapper.style.height = '350px'
                      popupWrapper.style.maxHeight = '350px'
                    }
                    if (popupContent) {
                      popupContent.style.height = '350px'
                      popupContent.style.maxHeight = '350px'
                    }
                    // Cập nhật lại kích thước popup nếu có method
                    if (popup && typeof popup.invalidateSize === 'function') {
                      popup.invalidateSize()
                    }
                  }
                  
                  if (mounted && mounted.length > 0) {
                    container._popupMounted = true
                  } else {
                    throw new Error('Failed to mount place-popup component')
                  }
                } else {
                  throw new Error('Could not find place-popup element')
                }
              } catch (error) {
                console.error('Error mounting place-popup:', error)
                console.error('Error details:', error.stack)
                container.innerHTML = `<div style="padding: 20px; color: red;">Erreur lors du chargement: ${error.message}</div>`
              }
            }, 50)
          }
        }
      }
    }
  </script>
</world-map>