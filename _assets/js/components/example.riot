<example>
  <h1>A example component</h1>

  Found these records:

  <ul>
    <li each={r in state['records']}>
      {r['current_city']},
      {r['current_house_number']}
      {r['current_street']}
    </li>
  </ul>

  <div>
    This is a translated string (see translations.json): {t('site_title')}
  </div>

  <script>
    import search from '../lib/search.instance'

    export default class {
      onBeforeMount(props, state) {
        search.myAction().then(data => {

          this.update({records: data['results']})
        })
      }
    }
  </script>
</example>
