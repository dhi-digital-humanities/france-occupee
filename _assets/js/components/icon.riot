<icon
  xmlns="http://www.w3.org/2000/svg"
  fill="currentColor"
  class={props.class}
>
  <use href="{rootUrl()}/assets/bootstrap-icons.svg#{props['bootstrapId']}"></use>

  <script>
    import config from '../../../_data/config'

    export default class {
      rootUrl() {
        return config().root_url
      }
    }
  </script>
</icon>
