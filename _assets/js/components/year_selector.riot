<year-selector>
  <div class="btn-group w-100" data-toggle="buttons">
    <template each={year in years()}>
      <label
        class="btn btn-primary w-6th {isChecked(year) ? 'active' : ''}"
        onclick={event => toggle(year, event)}
      >
        <input
          type="checkbox"
          class="btn-check"
          id="btn-check-year-{year}"
          value={year}
          onchange={event => toggle(year, event)}
        />
        {year}
      </label>
    </template>
  </div>
  

  <script>
    export default class {
      fromUrl() {
        const c = this.props['criteria']
        if (!c) return []
        if (!c['years']) return []

        const result = c['years'].split(/\s*,\s*/).map(y => parseInt(y))
        return result
      }

      onUpdated() {
        const inputs = this.root.querySelectorAll('input')
        for (const input of inputs) {
          input.checked = (input.getAttribute('checked') === 'checked')
        }
      }

      isChecked(year) {
        const fu = this.fromUrl()
        if (fu.length === 0) return true

        return this.fromUrl().indexOf(year) != -1
      }

      toggle(year, event) {
        event.preventDefault()
        event.stopPropagation()
        event.stopImmediatePropagation()

        let years = this.fromUrl()
        if (years.length === 0) {
          this.props.onInput({years: `${year}`})
          return
        }

        const index = years.indexOf(year)
        if (index == -1) {
          years.push(year)
          years = years.sort()
        } else {
          years.splice(index, 1)
        }

        if (years.length === this.years().length) {
          years = null
        } else {
          years = years.map(y => `${y}`).join(',')
        }

        this.props.onInput({years})
      }

      years() {
        return [1940, 1941, 1942, 1943, 1944, 1945]
      }
    }
  </script>
</year-selector>