{
  "type": "module",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@popperjs/core": "^2.10.2",
    "@riotjs/cli": "^10.0.0",
    "@riotjs/compiler": "^10.0.1",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^0.4.1",
    "@wendig/lib": "git+https://git.wendig.io/git/js-lib.git",
    "concurrently": "^9.1.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.2.3",
    "feather-icons": "^4.29.0",
    "leaflet": "^1.9.3",
    "leaflet.markercluster": "^1.5.3",
    "protomaps-leaflet": "^5.1.0",
    "riot": "^10.1.0",
    "rollup": "^4.24.4",
    "rollup-plugin-dotenv": "^0.5.1",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "rollup-plugin-riot": "^10.0.0",
    "sass": "^1.93.2"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev-js\" \"npm:dev-css\" \"npm:dev-11ty\"",
    "build": "npm run build-js && npm run build-css && npm run build-11ty",
    "dev-11ty": "npx @11ty/eleventy --serve --port=3000",
    "dev-js": "rollup -c -w --no-watch.clearScreen",
    "dev-css": "sass -c -w --update --source-map -I ./node_modules _assets/styles/app.scss assets/app.css",
    "dev-tile-server": "http-server ./data/tiles --cors",
    "build-11ty": "bash -c \"APP_ENV=production npx @11ty/eleventy\"",
    "build-js": "bash -c \"APP_ENV=production rollup -c --environment APP_ENV:production\"",
    "build-css": "sass -c --style=compressed --no-source-map -I ./node_modules _assets/styles/app.scss assets/app.css",
    "deploy": "node bin/fo.js deploy",
    "import": "node bin/fo.js import"
  }
}
